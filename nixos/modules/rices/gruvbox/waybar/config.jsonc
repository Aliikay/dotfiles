{
  "layer": "top",
  "spacing": 2,
  "width": -10,
  "height": 0,
  "margin-bottom": 0,
  "margin-top": 0,
  "position": "left",
  "margin-right": 0,
  "margin-left": 0,
  "output": ["eDP-1", "DP-5"],
  "modules-left": [
    "custom/systemmenu",
    "niri/workspaces",
    "privacy",
    "niri/window"
    // //"sway/workspaces",
    // //"hyprland/workspaces",
    // "niri/window"
  ],
  // "modules-center": [
  //   // "custom/applauncher",
  // ],
  "modules-right": [
    "tray",
    "custom/clipboard",
    "custom/notification",
    "group/monitors",
    // //"network",
    "cpu",
    "memory",
    "temperature",
    "group/batterygroup",
    "group/audio",
    "group/power"
  ],
  "custom/systemmenu": {
    "format": "󱄅",
    // "on-click": "alacritty -e rebuild.sh"
    "on-click": "~/dotfiles/scripts/toggle-launcher.sh"
    // "rotate": 270
  },
  "niri/workspaces": {
    "on-scroll-up": "niri msg action focus-workspace-up",
    "on-scroll-down": "niri msg action focus-workspace-down",
    // "format": "",
    "format": "{index}",
    "rotate": 270
  },
  "niri/window": {
    "rewrite": {
      "(.*) — Zen Browser": "$1"
    },
    "on-click": "niri msg action toggle-overview",
    "rotate": 270
  },
  "custom/applauncher": {
    "format": "〇",
    "on-click": "~/dotfiles/scripts/toggle-launcher.sh",
    "tooltip": false,
    "rotate": 270
  },
  "custom/notification": {
    "tooltip": false,
    "format": "{icon}",
    "format-icons": {
      "notification": "󱅫",
      "none": "",
      "dnd-notification": " ",
      "dnd-none": " ",
      "inhibited-notification": " ",
      "inhibited-none": "",
      "dnd-inhibited-notification": " ",
      "dnd-inhibited-none": " "
    },
    "return-type": "json",
    "exec-if": "which swaync-client",
    "exec": "swaync-client -swb",
    "on-click": "sleep 0.1 && swaync-client -t -sw",
    "on-click-right": "sleep 0.1 && swaync-client -d -sw",
    "escape": true
    // "rotate": 270
  },
  "tray": {
    "spacing": 5,
    "tooltip": false,
    "rotate": 270
  },
  "clock": {
    //"format": "󰅐 {:%H:%M}",
    "format": "{:%OI\n%M\n%p}",
    "tooltip-format": "<big>{:%Y %B %e}</big>\n<tt><small>{calendar}</small></tt>",
    "on-click": "wlogout"
  },
  "network": {
    "format-wifi": "  {bandwidthDownBits}",
    "format-ethernet": "  {bandwidthDownBits}",
    "format-disconnected": "󰤮  No Network",
    "interval": 5,
    "tooltip": false,
    "rotate": 270
  },
  "cpu": {
    // "format": " {usage}",
    // "tooltip": false,
    "format": "",
    "states": {
      "critical": 80,
      "high": 30,
      "medium": 5,
      "low": 0
    },
    "on-click": "alacritty -e btop"
  },
  "memory": {
    "format": "",
    "unit": "GB",
    "tooltip-format": "{percentage}%",
    "states": {
      "critical": 80,
      "high": 70,
      "medium": 50,
      "low": 0
    },
    "on-click": "alacritty -e btop"
  },
  "temperature": {
    "format": "",
    "hwmon-path": "/sys/devices/pci0000:00/0000:00:1c.0/0000:ab:00.0/nvme/nvme0/hwmon0/temp1_input",
    "critical-threshold": 70,
    "warning-threshold": 60,
    "on-click": "alacritty -e bash -c 'sudo iotop'"
  },
  "group/audio": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "group-audio-children",
      "transition-left-to-right": false
    },
    "modules": ["pulseaudio", "mpd"],
    "rotate": 270
  },
  "pulseaudio": {
    "scroll-step": 5,
    "max-volume": 150,
    "format": "{icon}",
    "format-bluetooth": "{icon}",
    "format-icons": ["󰕿", "󰖀", "󰕾"],
    "nospacing": 1,
    "format-muted": " ",
    "on-click": "pavucontrol",
    "on-click-right": "~/dotfiles/scripts/swayosd-autostart.sh --output-volume mute-toggle",
    "on-scroll-up": "~/dotfiles/scripts/swayosd-autostart.sh --output-volume raise --max-volume 150",
    "on-scroll-down": "~/dotfiles/scripts/swayosd-autostart.sh --output-volume lower --max-volume 150",
    "tooltip": false
  },
  "mpd": {
    "format": "{stateIcon} {title} ⸨{songPosition}|{queueLength}⸩ {volume}%",
    "format-disconnected": "", //"Disconnected ",
    "format-stopped": "", //"{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}Stopped ",
    "unknown-tag": "N/A",
    "interval": 2,
    "consume-icons": {
      "on": "  "
    },
    "random-icons": {
      "on": "  "
    },
    "repeat-icons": {
      "on": "  "
    },
    "single-icons": {
      "on": "1  "
    },
    "state-icons": {
      "paused": "",
      "playing": ""
    },
    "tooltip-format": "{consumeIcon}{randomIcon}{repeatIcon}{singleIcon}  |  Now Playing: {title}\n     ({album})",
    "tooltip-format-disconnected": "MPD (disconnected)",
    "on-scroll-up": "mpc volume +5",
    "on-scroll-down": "mpc volume -5",
    "on-click": "mpc toggle",
    "rotate": 270
  },
  "custom/clipboard": {
    "format": "",
    "on-click": "cliphist list | fuzzel --dmenu --lines 32 --anchor top | cliphist decode | wl-copy",
    "on-click-right": "zenity --question --title=\"Clear history?\" --text=\"Clear all of the clipboard history?\" && cliphist wipe"
    // "rotate": 270
  },
  "group/batterygroup": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "group-battery-children",
      "transition-left-to-right": false
    },
    "modules": ["battery", "power-profiles-daemon"],
    "rotate": 270
  },
  "battery": {
    "states": {
      "full": 79,
      "warning": 30,
      "critical": 15
    },
    // "format": "{icon} {capacity}%",
    // "format-charging": "󰂄 {capacity}%",
    // "format-plugged": "󰂄 {capacity}%",
    "format": "{icon}",
    "format-charging": "󰂄",
    "format-plugged": "󰂄",
    // "format-alt": "{icon} {time}",
    "format-full": "󱈑 {capacity}%",
    "format-icons": ["󱊡", "󱊢", "󱊣"],
    "on-click": "alacritty -e batmon"
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "tooltip": true,
    "format-icons": {
      "default": " ",
      "performance": " ",
      "balanced": " ",
      "power-saver": " "
    }
    // "rotate": 270
  },
  "group/power": {
    "orientation": "inherit",
    "drawer": {
      "transition-duration": 300,
      "children-class": "group-power-children",
      "transition-left-to-right": false
    },
    "modules": [
      "clock",
      "custom/power", // First element is the "group leader" and won't ever be hidden
      "custom/quit",
      "custom/lock",
      "custom/sleep",
      "custom/reboot"
    ],
    "rotate": 270
  },
  "custom/quit": {
    "format": "󰗼",
    "tooltip": "Logout",
    "on-click": "zenity --question --title=\"Logout?\" --text=\"Logout of the computer?\" && niri msg action quit -s"
    // "rotate": 270
  },
  "custom/lock": {
    "format": "󰍁",
    "tooltip": "Lock",
    "on-click": "niri msg action power-off-monitors && swaylock"
    // "rotate": 270
  },
  "custom/reboot": {
    "format": "󰜉",
    "tooltip": "Reboot",
    "on-click": "zenity --question --title=\"Reboot?\" --text=\"Reboot the computer?\" && reboot"
    // "rotate": 270
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": "Shutdown",
    "on-click": "zenity --question --title=\"Shutdown?\" --text=\"Shutdown the computer?\" && shutdown now"
    // "rotate": 270
  },
  "custom/sleep": {
    "format": "⏾",
    "tooltip": "Sleep",
    "on-click": "zenity --question --title=\"Sleep?\" --text=\"Sleep the computer?\" && systemctl sleep"
    // "rotate": 270
  }
}
